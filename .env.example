# FITLIFE Gym Membership Management System
# Environment Configuration Template

# Database Connection (PostgreSQL / Supabase)
# For Supabase:
# DATABASE_URL uses the Transaction Pooler (port 6543) with ?pgbouncer=true
# DIRECT_URL uses the Direct Connection / Session Pooler (port 5432) for migrations
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication & Session Secrets
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Safe Initial Administrator Seed Account (Used by seed script)
ADMIN_DEFAULT_EMAIL="admin@fitlife.com"
ADMIN_DEFAULT_PASSWORD="Admin@Fitlife2026!"
ADMIN_DEFAULT_NAME="Fitlife General Manager"

# Cron Endpoint Protection Secret (For scheduled reminders)
CRON_SECRET="your-strong-random-cron-secret-token"

# Transactional Email Provider (Resend)
# Leave empty in local development to automatically use Local Mock Email Logger
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FITLIFE Fitness Club <onboarding@resend.dev>"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timezone (Default: Indian Standard Time Asia/Kolkata)
TIMEZONE="Asia/Kolkata"

# Payment Gateway (Razorpay Sandbox/Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Supabase API (Client SDK / Storage / Auth)
# Find your anon key in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
